{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PropertyList",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "name", "domain", "definition"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
      "name": { "type": "string" },
      "domain": { "type": "string" },
      "definition": { "type": "string" },
      "equivalentForms": {
        "type": "array",
        "items": { "type": "string" }
      },
      "examples": {
        "type": "array",
        "items": { "type": "string" }
      },
      "nonExamples": {
        "type": "array",
        "items": { "type": "string" }
      },
      "notes": { "type": "string" }
    },
    "additionalProperties": false
  }
}
