{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StatementList",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "kind", "from", "to", "context", "source", "verified"],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
      "kind": { "type": "string", "enum": ["implies", "equivalent", "not-implies"] },
      "from": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1
      },
      "to": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1
      },
      "context": { "type": "string" },
      "name": { "type": "string" },
      "proofSketch": { "type": "string" },
      "keyLemma": { "type": "string" },
      "witness": { "type": "string" },
      "source": { "type": "string" },
      "verified": { "type": "boolean" },
      "leanName": { "type": "string" }
    },
    "additionalProperties": false
  }
}
